# ==============================================================================
# CryoLens Environment Configuration (.env.example)
# Copy this file to .env and populate with your credentials.
# NEVER commit the real .env file into source control.
# ==============================================================================

# --- Application & Storage ---
CRYOLENS_ENV=development
CRYOLENS_LOG_LEVEL=INFO
CRYOLENS_DATA_DIR=./data
CRYOLENS_CACHE_DIR=./data/cache

# --- Database (PostgreSQL 16 + PostGIS 3.4) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cryolens
POSTGRES_USER=cryolens_user
POSTGRES_PASSWORD=

# --- Copernicus Data Space Ecosystem (CDSE) ---
# Required for programmatic STAC queries and Sentinel-1 scene downloads
# Endpoints and collection IDs are configured in configs/project.yaml
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- NASA Earthdata / ASF DAAC ---
# Required for ASF DAAC bulk search, IIP database (G00807), and SIGRID-3
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Microsoft Planetary Computer ---
# Optional SAS token / subscription key for high-throughput signed reads
PC_SDK_SUBSCRIPTION_KEY=

# --- Copernicus Marine Service (CMEMS) ---
# Required for ocean current fields (GLORYS12V1 reanalysis & live Analysis/Forecast)
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# --- Kaggle CLI ---
# Required for automated download of the Statoil/C-CORE Iceberg Challenge dataset
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- MLflow Tracking ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=cryolens-benchmarks
